---
const address = '秋田県湯沢市皆瀬字小湯ノ上3-14';
// APIキー不要で埋め込める形式。正式な埋め込みコードに差し替えてもOK
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&z=14&output=embed`;

// 交通アクセスの詳細（見出し＋詳細リスト）
const accessRoutes = [
  {
    heading: 'お車でお越しの方',
    items: [
      '東北自動車道 湯沢ICより 国道398号線 約67km・約100分（冬期は通行止めになります）',
      '秋田自動車道 湯沢ICより 国道398号線 約30km・約45分',
    ],
  },
  {
    heading: '公共交通機関でお越しの方',
    items: [
      'JR奥羽本線 湯沢駅よりバス（小安温泉方面）乗車、小安温泉下車 徒歩2分',
    ],
  },
];
---
<section id="access" class="section access">
  <div class="inner">
    <div class="title-wrapper" data-animate="title">
      <h2 class="title">アクセス</h2>
    </div>

    <div class="content">
      <div class="map" data-animate="scale-in">
        <iframe
          src={mapSrc}
          title="鶴峯館 周辺地図"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <dl class="info" data-animate="fade-up">
        <div class="info__row">
          <dt class="info__term">所在地</dt>
          <dd class="info__desc">
            〒012-0183<br>
            秋田県湯沢市皆瀬字小湯ノ上3-14
          </dd>
        </div>
        <div class="info__row">
          <dt class="info__term">TEL</dt>
          <dd class="info__desc">0183-47-5335</dd>
        </div>
        <div class="info__row">
          <dt class="info__term">FAX</dt>
          <dd class="info__desc">0183-47-5228</dd>
        </div>
      </dl>
    </div>
    {/* ===== 交通アクセス詳細 ===== */}
    <div class="routes" data-animate="fade-up">
      {accessRoutes.map((route) => (
        <div class="routes__block">
          <h3 class="routes__heading">{route.heading}</h3>
          <ul class="routes__list">
            {route.items.map((item) => (
              <li class="routes__item">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  /* ===== 見出し（About / Goaisatsu と共通の装飾線パターン）===== */
  .title-wrapper {
    text-align: center;
  }

  .title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    font-size: 2rem;

    @include tablet {
      font-size: 1rem;
    }

    &::before,
    &::after {
      content: '';
      display: block;
      max-width: 200px;
      width: 100%;
      height: 1px;
      background: #fff;

      @include tablet {
        max-width: 100px;
      }

      @include sp {
        width: 50px;
      }
    }
  }

  /* ===== レイアウト：左に地図 / 右に情報 ===== */
  .content {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
    margin-top: 60px;

    @include tablet {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  /* ===== 地図 ===== */
  .map {
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(232, 224, 200, 0.3);

    iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
  }

  /* ===== 情報（Footer の dl パターンを踏襲）===== */
  .info {
    display: flex;
    flex-direction: column;
  }

  .info__row {
    display: flex;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(232, 224, 200, 0.3);

    &:first-child {
      padding-top: 0;
    }

    &:last-child {
      border-bottom: none;
    }
  }

  .info__term {
    flex-shrink: 0;
    min-width: 5em;
    font-weight: normal;
    letter-spacing: 0.1em;
  }

  .info__desc {
    font-size: 0.875rem;
    line-height: 1.9;
    letter-spacing: 0.05em;
  }

    /* ===== 交通アクセス詳細 ===== */
    .routes {
    margin-top: 60px;

    @include tablet {
      margin-top: 48px;
    }
  }

  .routes__block + .routes__block {
    margin-top: 40px;

    @include sp {
      margin-top: 32px;
    }
  }

  /* 見出し：先頭にひし形アイコン＋下線 */
  .routes__heading {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(232, 224, 200, 0.3);
    font-family: $font-heading;
    font-weight: 500;
    font-size: 1.25rem;
    letter-spacing: 0.12em;
    line-height: 1.6;

    @include tablet {
      font-size: 1.125rem;
    }

    @include sp {
      font-size: 1rem;
      gap: 10px;
      padding-bottom: 12px;
    }

    &::before {
      content: '';
      flex-shrink: 0;
      width: 10px;
      height: 10px;
      background: currentColor;
      transform: rotate(45deg); // 正方形を回転してひし形に

      @include sp {
        width: 8px;
        height: 8px;
      }
    }
  }

  /* 詳細リスト：先頭に短いダッシュ＋ぶら下げインデント */
  .routes__list {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;

    @include sp {
      margin-top: 18px;
      gap: 12px;
    }
  }

  .routes__item {
    position: relative;
    padding-left: 1.4em;
    font-size: 0.95rem;
    line-height: 1.9;
    letter-spacing: 0.05em;

    @include sp {
      font-size: 0.85rem;
      padding-left: 1.2em;
    }

    &::before {
      content: '';
      position: absolute;
      top: 0.85em;
      left: 0;
      width: 0.7em;
      height: 1px;
      background: currentColor;
      opacity: 0.7;
    }
  }
</style>